# Every variable the backend reads. Names only, never values.
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Settings use extra="forbid", so a key here that app/core/settings.py does not
# declare will stop the process at startup rather than be ignored.

# local | staging | production
ENVIRONMENT=local

# true only for local work. Never true in a deployed environment.
DEBUG=false

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# --- Slice 2: identity and isolation ---

# Supabase session pooler, port 5432. NOT the transaction pooler on 6543:
# transaction mode disables prepared statements, which asyncpg needs.
# A password containing @ # / ? must be percent-encoded.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Project URL. The JWT issuer is this value plus /auth/v1.
SUPABASE_URL=https://<ref>.supabase.co

# Public keys for token verification. No secret here.
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# The anon/publishable key. Same value the frontend uses (VITE_SUPABASE_PUBLISHABLE_KEY).
# Not a secret: authorises calls to Supabase's public Auth API, nothing more.
SUPABASE_PUBLISHABLE_KEY=

# --- Slice 3: the gateway ---

# The Slashit-held provider credential. One key, all users.
# Never in the client, never in a response, never in a log. Requirement FR-1.
GEMINI_API_KEY=

# The model. Changing it is configuration, not a deploy. Requirement FR-17.
GEMINI_MODEL=gemini-3.6-flash

# Kill switch. false makes every extraction return ProviderUnavailable without
# calling out. One variable, no deploy.
GATEWAY_ENABLED=true

# --- Epic 003: reminder firing (sub-plan 4.4) ---

# Kill switch. false stops the every-minute sweep; nothing fires until true.
REMINDERS_FIRING_ENABLED=true

# --- Epic 003: reminder email (sub-plan 4.3) ---

# Off until a sending domain is verified in Resend (staging/production) or
# SMTP is filled in (local). true needs the pair below for the current
# environment.
REMINDER_EMAIL_ENABLED=false

# Resend API key. A secret: never in the client, a response or a log.
# Read only when ENVIRONMENT is staging or production.
RESEND_API_KEY=

# The From line, on a domain verified in Resend: Slashit <reminders@your-domain>
# Read only when ENVIRONMENT is staging or production.
REMINDER_EMAIL_FROM=

# --- Epic 003: local email, before a Resend domain is verified (2026-09-26 dev log) ---
# Read only when ENVIRONMENT=local. Point these at any SMTP relay you can
# reach locally (e.g. Mailtrap, Gmail with an app password, or a local
# catch-all like Mailpit) so real sends are visible in development.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# A secret: never in the client, a response or a log.
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# Where the email's "Open in Slashit" link points.
APP_BASE_URL=http://localhost:5173
